# Copy to .env (gitignored) and fill in. NEVER commit .env.
# docker compose reads .env automatically (SQL_SA_PASSWORD).
# For the API: load it into your shell before running, e.g.
#   set -a; source .env; set +a; cd src/ClinicApp.Api && dotnet run

# SQL Server 'sa' password for the local Docker container (clinic-mssql)
SQL_SA_PASSWORD='change-me-strong-password'

# ASP.NET Core env vars (override appsettings*.json)
ConnectionStrings__DefaultConnection='Server=localhost,1433;Database=ClinicAppDb;User Id=sa;Password=change-me-strong-password;TrustServerCertificate=True;Encrypt=False'
# 32+ chars; must equal JWT_SECRET in Project02-fe/.env.local
Jwt__Secret='change-me-random-string-of-32-or-more-characters'
